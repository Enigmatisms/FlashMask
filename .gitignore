# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# IDE-related
.idea/
.vscode/

# pytest
.pytest_cache/

# Generated by the optional CUDA submodule builds (see setup.py)
.eggs/
flashmask/utils/flashmask_cuda_utils.py

# Test & benchmark artifacts. The benchmarks (tests/*/benchmark_flashmask.py),
# the radar/bar plots (tests/common/plot_radar.py) and the CP-overlap launchers
# write these next to wherever they are run from -- never commit them.
# NOTE: gitignore has no inline comments, so keep each pattern on its own line.
# tests/common/kernel_test_seq_info.txt is a tracked input, not an artifact.
# benchmark CSV output ({dtype}{suffix}/*.csv)
*.csv
# plot_radar.py figures (png + pdf live under fig/)
fig/
# Nsight Compute / Systems profiler captures
*.ncu-rep
*.nsys-rep
# sweep.log and other loose run logs
*.log
# CP-overlap launcher --log_dir directories
log_cp*/
